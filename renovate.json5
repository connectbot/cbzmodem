{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "packageRules": [
    {
      "description": "Keep release workflows on main to match Octo STS job_workflow_ref trust policies",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/release.yml"
      ],
      "matchDepNames": [
        "connectbot/actions",
        "connectbot/actions/**"
      ],
      "enabled": false
    },
  ]
}
